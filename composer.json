{
    "name": "phpcolor/phpcolor",
    "description": "PHP Color",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "php",
        "color"
    ],
    "authors": [
        {
            "name": "Simon André",
            "email": "smn.andre@gmail.com"
        },
        {
            "name": "Raphaël Geffroy",
            "email": "raphael@geffroy.dev"
        }
    ],
    "homepage": "https://phpcolor.dev",
    "support": {
        "issues": "https://github.com/phpcolor/phpcolor/issues",
        "source": "https://github.com/phpcolor/phpcolor/"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/smnandre"
        }
    ],
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "phpstan/phpstan": "^2.1"
    },
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "PhpColor\\Color\\": "src/"
        },
        "files": [
            "src/Support/functions.php"
        ],
        "exclude-from-classmap": [
            "tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "PhpColor\\Color\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "cs": "php-cs-fixer fix",
        "qa": [
            "@cs",
            "@sa",
            "@test"
        ],
        "sa": "phpstan analyse --memory-limit=1G",
        "test": "phpunit"
    }
}
